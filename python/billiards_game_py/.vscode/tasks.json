{
    // The board's tasks, through endpoint-cli (USB). Terminal > Run Task lists them.
    // The program's "packages" folder (from "pip install") goes along and is on
    // the board's Python path (PYTHONPATH).
    "version": "2.0.0",
    "tasks": [
        {
            "label": "endpoint: stop",
            "detail": "Stop the program running on the board",
            "type": "endpoint",
            "args": ["stop", "app"],
            "problemMatcher": []
        },

        {
            "label": "endpoint: deploy for debugging",
            "type": "endpoint",
            "args": ["deploy", "--exclude", ".*", "--exclude", "__pycache__",
                     "${workspaceFolder}", "/data/debug/${workspaceFolderBasename}"],
            "dependsOn": "endpoint: stop",
            "problemMatcher": []
        },
        {
            "label": "endpoint: start debugging",
            "detail": "Used by F5",
            "type": "endpoint",
            "args": ["run", "--debug-port", "5678", "--tag", "app",
                     "--cwd", "/data/debug/${workspaceFolderBasename}",
                     "--env", "PYTHONPATH=/data/debug/${workspaceFolderBasename}/packages",
                     "--env", "PYDEVD_DISABLE_FILE_VALIDATION=1",
                     "/usr/bin/python3", "-u",
                     "-m", "debugpy", "--listen", "127.0.0.1:5678", "--wait-for-client",
                     "${config:endpoint.main}"],
            "dependsOn": "endpoint: deploy for debugging",
            "isBackground": true,
            "problemMatcher": {
                "owner": "endpoint",
                "pattern": { "regexp": "^endpoint-cli: (.*)$", "message": 1 },
                "background": {
                    "activeBegins": true,
                    "beginsPattern": "^Forwarding localhost",
                    "endsPattern": "^Forwarding localhost"
                }
            }
        },

        {
            "label": "endpoint: deploy",
            "type": "endpoint",
            "args": ["deploy", "--exclude", ".*", "--exclude", "__pycache__",
                     "${workspaceFolder}", "/data/apps/${workspaceFolderBasename}"],
            "dependsOn": "endpoint: stop",
            "problemMatcher": []
        },
        {
            "label": "endpoint: run",
            "detail": "Run on the board without the debugger and show the output (Ctrl+C stops it)",
            "type": "endpoint",
            "args": ["run", "--tag", "app", "--cwd", "/data/apps/${workspaceFolderBasename}",
                     "--env", "PYTHONPATH=/data/apps/${workspaceFolderBasename}/packages",
                     "/usr/bin/python3", "-u", "${config:endpoint.main}"],
            "dependsOn": "endpoint: deploy",
            "problemMatcher": []
        },
        {
            "label": "endpoint: set run at boot",
            "type": "endpoint",
            "args": ["autostart", "--cwd", "/data/apps/${workspaceFolderBasename}",
                     "--env", "PYTHONPATH=/data/apps/${workspaceFolderBasename}/packages",
                     "/usr/bin/python3", "${config:endpoint.main}"],
            "problemMatcher": []
        },
        {
            "label": "endpoint: start in background",
            "type": "endpoint",
            "args": ["run", "--detach", "--tag", "app", "--cwd", "/data/apps/${workspaceFolderBasename}",
                     "--env", "PYTHONPATH=/data/apps/${workspaceFolderBasename}/packages",
                     "/usr/bin/python3", "${config:endpoint.main}"],
            "problemMatcher": []
        },
        {
            "label": "endpoint: run at boot",
            "detail": "Run on the board now and at every boot",
            "dependsOrder": "sequence",
            "dependsOn": ["endpoint: deploy", "endpoint: set run at boot", "endpoint: start in background"],
            "problemMatcher": []
        },
        {
            "label": "endpoint: stop run at boot",
            "detail": "Start nothing at boot",
            "type": "endpoint",
            "args": ["autostart", "--off"],
            "problemMatcher": []
        }
    ]
}
